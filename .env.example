# Password to log into /admin and upload a new CV or photo.
ADMIN_PASSWORD=

# Vercel Blob storage: create a store (dashboard > Storage > Create Database >
# Blob) and connect it to this project. Vercel injects BLOB_STORE_ID and
# VERCEL_OIDC_TOKEN automatically for you; no token needs to be set here.
# For local dev, run `vercel link` then `vercel env pull` once to get them.
